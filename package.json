{
  "name": "wenxuan-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/astro/astro.js dev",
    "gen:meta": "bun scripts/gen-meta.ts",
    "geo:audit": "bun scripts/gen-meta.ts && bun scripts/geo-audit.ts",
    "cluster:audit": "bun scripts/gen-meta.ts && bun scripts/cluster-audit.ts",
    "link:suggest": "bun scripts/gen-meta.ts && bun scripts/internal-link-suggest.ts",
    "answer:audit": "bun scripts/gen-meta.ts && bun scripts/answer-block-audit.ts",
    "geo:execute": "bun scripts/gen-meta.ts && bun scripts/geo-audit.ts && bun scripts/cluster-audit.ts && bun scripts/internal-link-suggest.ts && bun scripts/answer-block-audit.ts",
    "build": "bun scripts/gen-meta.ts && bun node_modules/astro/astro.js build",
    "preview": "bun node_modules/astro/astro.js preview",
    "check": "bun node_modules/astro/astro.js check"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.0",
    "astro": "^5.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
