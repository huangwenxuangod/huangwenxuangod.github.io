---
import BaseLayout from "../../layouts/BaseLayout.astro";
import meta from "../../content/projects/_meta.json";
import { getCollection } from "astro:content";
import { absoluteUrl, breadcrumbJsonLd, personJsonLd, SITE_NAME } from "../../lib/seo";

type MetaItem = {
  id: string;
  slug: string;
  title: string;
  date: string;
  updated?: string;
  description?: string;
  tags?: string[];
  wordCount?: number;
  indexable?: boolean;
};

function formatDateMid(ymd: string) {
  const [y, m, d] = ymd.split("-");
  return `${y} · ${m} · ${d}`;
}

export async function getStaticPaths() {
  const posts = meta as MetaItem[];
  return posts.map((p) => ({ params: { slug: p.slug }, props: { id: p.id } }));
}

const { id } = Astro.props as { id: string };
const collection = await getCollection("projects");
const entry = collection.find((e) => e.id === id);

if (!entry) {
  throw new Error(`Missing project entry for id: ${id}`);
}

const m = (meta as MetaItem[]).find((p) => p.id === id);
const { Content } = await entry.render();
const site = Astro.site ?? new URL("https://huangwenxuangod.github.io");
const title = m?.title ?? entry.data.title;
const pagePath = `/projects/${m?.slug}/`;
const projectUrl = absoluteUrl(pagePath, site);
const tags = m?.tags ?? entry.data.tags ?? entry.data.stack ?? [];
const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${projectUrl}#creativework`,
  name: title,
  headline: title,
  description: m?.description ?? entry.data.summary,
  url: projectUrl,
  datePublished: m?.date,
  dateModified: m?.updated ?? m?.date,
  author: { "@id": `${absoluteUrl("/about/", site)}#person` },
  creator: { "@id": `${absoluteUrl("/about/", site)}#person` },
  keywords: tags,
  inLanguage: "zh-CN"
};
---

<BaseLayout
  title={title}
  description={m?.description ?? entry.data.summary}
  canonical={pagePath}
  noindex={m?.indexable === false}
  jsonLd={[
    personJsonLd(site),
    projectJsonLd,
    breadcrumbJsonLd([
      { name: SITE_NAME, path: "/" },
      { name: "项目", path: "/projects/" },
      { name: title, path: pagePath }
    ], site)
  ]}
>
  <article class="article-wrap case-wrap">
    <div class="article-topline">
      <a href="/projects" class="back-btn">
        <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M5 1L1 5l4 4M1 5h10" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        返回项目
      </a>
    </div>

    <div class="article-meta">{formatDateMid(m?.date ?? "0000-00-00")}</div>
    <h1 class="article-title">{title}</h1>

    <div class="figure-placeholder">
      <span>示意图位置</span>
      <small>流程图 / 截图 / 架构图 / 产品界面</small>
    </div>

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
