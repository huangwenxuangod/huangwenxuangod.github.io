---
import BaseLayout from "../../layouts/BaseLayout.astro";
import meta from "../../content/achievements/_meta.json";
import { getCollection } from "astro:content";
import { absoluteUrl, breadcrumbJsonLd, personJsonLd, SITE_NAME } from "../../lib/seo";

type MetaItem = {
  id: string;
  slug: string;
  title: string;
  date: string;
  updated?: string;
  description?: string;
  tags?: string[];
  wordCount?: number;
  indexable?: boolean;
};

function formatDateMid(ymd: string) {
  const [y, m, d] = ymd.split("-");
  return `${y} · ${m} · ${d}`;
}

export async function getStaticPaths() {
  const posts = meta as MetaItem[];
  return posts.map((p) => ({ params: { slug: p.slug }, props: { id: p.id } }));
}

const { id } = Astro.props as { id: string };
const collection = await getCollection("achievements");
const entry = collection.find((e) => e.id === id);

if (!entry) {
  throw new Error(`Missing achievement entry for id: ${id}`);
}

const m = (meta as MetaItem[]).find((p) => p.id === id);
const { Content } = await entry.render();
const site = Astro.site ?? new URL("https://huangwenxuangod.github.io");
const title = m?.title ?? entry.data.title;
const pagePath = `/achievements/${m?.slug}/`;
const achievementUrl = absoluteUrl(pagePath, site);
const tags = m?.tags ?? entry.data.tags ?? [];
const achievementJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${achievementUrl}#article`,
  headline: title,
  description: m?.description ?? entry.data.summary,
  url: achievementUrl,
  datePublished: m?.date,
  dateModified: m?.updated ?? m?.date,
  author: { "@id": `${absoluteUrl("/about/", site)}#person` },
  publisher: { "@id": `${absoluteUrl("/about/", site)}#person` },
  keywords: tags,
  articleSection: "成果",
  wordCount: m?.wordCount,
  isAccessibleForFree: true,
  inLanguage: "zh-CN"
};
---

<BaseLayout
  title={title}
  description={m?.description ?? entry.data.summary}
  type="article"
  canonical={pagePath}
  publishedTime={m?.date}
  modifiedTime={m?.updated ?? m?.date}
  noindex={m?.indexable === false}
  jsonLd={[
    personJsonLd(site),
    achievementJsonLd,
    breadcrumbJsonLd([
      { name: SITE_NAME, path: "/" },
      { name: "成果", path: "/achievements/" },
      { name: title, path: pagePath }
    ], site)
  ]}
>
  <article class="article-wrap case-wrap">
    <div class="article-topline">
      <a href="/achievements" class="back-btn">
        <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M5 1L1 5l4 4M1 5h10" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        返回成果
      </a>
    </div>

    <div class="article-meta">{formatDateMid(m?.date ?? "0000-00-00")}</div>
    <h1 class="article-title">{title}</h1>

    <div class="figure-placeholder">
      <span>证据图位置</span>
      <small>数据图 / 截图 / 链接证明 / 前后对比</small>
    </div>

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
