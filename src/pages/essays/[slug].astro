---
import BaseLayout from "../../layouts/BaseLayout.astro";
import meta from "../../content/blog/_meta.json";
import { getCollection } from "astro:content";
import {
  AUTHOR_NAME,
  SITE_NAME,
  absoluteUrl,
  breadcrumbJsonLd,
  personJsonLd
} from "../../lib/seo";

type MetaItem = {
  id: string;
  slug: string;
  title: string;
  date: string;
  updated?: string;
  description?: string;
  tags?: string[];
  wordCount?: number;
  readingTime?: number;
  indexable?: boolean;
};

function formatDateMid(ymd: string) {
  const [y, m, d] = ymd.split("-");
  return `${y} · ${m} · ${d}`;
}

export async function getStaticPaths() {
  const posts = meta as MetaItem[];
  return posts.map((p) => ({ params: { slug: p.slug }, props: { id: p.id } }));
}

const { id } = Astro.props as { id: string };
const collection = await getCollection("blog");
const entry = collection.find((e) => e.id === id);

if (!entry) {
  throw new Error(`Missing essay entry for id: ${id}`);
}

const m = (meta as MetaItem[]).find((p) => p.id === id);
const { Content } = await entry.render();

const all = meta as MetaItem[];
const currentIndex = all.findIndex((p) => p.id === id);
const prev = currentIndex >= 0 ? all[currentIndex + 1] : undefined;
const next = currentIndex >= 0 ? all[currentIndex - 1] : undefined;
const site = Astro.site ?? new URL("https://huangwenxuangod.github.io");
const title = m?.title ?? entry.data.title ?? "未命名";
const pagePath = `/essays/${m?.slug}/`;
const articleUrl = absoluteUrl(pagePath, site);
const tags = m?.tags ?? entry.data.tags ?? [];
const related = all
  .filter((post) => post.id !== id)
  .map((post) => {
    const shared = (post.tags ?? []).filter((tag) => tags.includes(tag)).length;
    return { post, shared };
  })
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .map(({ post }) => post)
  .slice(0, 3);
const fallbackRelated = related.length > 0 ? related : [next, prev].filter(Boolean).slice(0, 2);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  headline: title,
  description: m?.description,
  url: articleUrl,
  datePublished: m?.date,
  dateModified: m?.updated ?? m?.date,
  author: {
    "@id": `${absoluteUrl("/about/", site)}#person`
  },
  publisher: {
    "@id": `${absoluteUrl("/about/", site)}#person`
  },
  mainEntityOfPage: articleUrl,
  keywords: tags,
  articleSection: tags[0] ?? "思考",
  wordCount: m?.wordCount,
  isAccessibleForFree: true,
  inLanguage: "zh-CN"
};
---

<BaseLayout
  title={title}
  description={m?.description}
  type="article"
  canonical={pagePath}
  publishedTime={m?.date}
  modifiedTime={m?.updated ?? m?.date}
  noindex={m?.indexable === false}
  jsonLd={[
    personJsonLd(site),
    articleJsonLd,
    breadcrumbJsonLd([
      { name: SITE_NAME, path: "/" },
      { name: "思考", path: "/essays/" },
      { name: title, path: pagePath }
    ], site)
  ]}
>
  <article class="article-wrap">
    <div class="article-topline">
      <a href="/essays" class="back-btn">
        <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M5 1L1 5l4 4M1 5h10" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        返回思考
      </a>
    </div>

    <div class="article-meta">
      {formatDateMid(m?.date ?? "0000-00-00")}
      {m?.updated && m.updated !== m.date && <span> · 更新 {formatDateMid(m.updated)}</span>}
      {m?.readingTime && <span> · {m.readingTime} 分钟读完</span>}
    </div>
    <h1 class="article-title">{title}</h1>
    {tags.length > 0 && (
      <div class="article-tags" aria-label="文章标签">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}

    <div class="article-body">
      <Content />
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="文章导航">
        {next && (
          <a href={`/essays/${next.slug}/`}>
            <span class="nav-label">上一篇</span>
            {next.title}
          </a>
        )}
        {prev && (
          <a href={`/essays/${prev.slug}/`} class="nav-next">
            <span class="nav-label">下一篇</span>
            {prev.title}
          </a>
        )}
      </nav>
    )}
    {fallbackRelated.length > 0 && (
      <aside class="related-posts" aria-label="相关文章">
        <span class="related-label">Related</span>
        <h2>继续读这些相关思考</h2>
        <div>
          {fallbackRelated.map((post) => (
            <a href={`/essays/${post.slug}/`}>{post.title}</a>
          ))}
        </div>
      </aside>
    )}
  </article>
</BaseLayout>
